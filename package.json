{
  "name": "iworship",
  "version": "0.1.0",
  "description": "iWorship — a cloud-based Baptist hymnal, chord book, and live worship-session app.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "seed": "node scripts/seed-firestore.mjs",
