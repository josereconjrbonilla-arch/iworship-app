    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes"
  },
  "dependencies": {
    "firebase": "^12.0.0"
  },
  "devDependencies": {
    "firebase-admin": "^13.10.0",
    "firebase-tools": "^13.0.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.0"
  }
}
